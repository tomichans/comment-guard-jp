# このファイルを .env.local にコピーして値を入れる（.env.local はコミットしない）。
# ローカル開発では `npx supabase start` の後に `npx supabase status` で表示される値を使う。

# [Supabase固有] プロジェクトのURLと anon キー。
# NEXT_PUBLIC_ で始まる変数はブラウザに公開される（Next.js の仕様）。
# anon キーは公開前提のキーで、データの保護は RLS が担う。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [Supabase固有] service role キー。RLS を無視して全データにアクセスできる。
# 絶対にブラウザへ出さない（NEXT_PUBLIC_ を付けない）。サーバーの src/server/ からのみ使う。
SUPABASE_SERVICE_ROLE_KEY=

# 期限切れ削除ジョブ（/api/cron/purge-expired）を呼び出すための共有シークレット。
# 推測されない長いランダム文字列にする（例：openssl rand -hex 32）。
CRON_SECRET=

# YouTube Data API v3 の APIキー。取得方法は README の「YouTube APIキーの取得」を参照。
# サーバーからだけ使う（NEXT_PUBLIC_ を付けない）。
YOUTUBE_API_KEY=

# ゲストのIPアドレスを、そのまま保存せずに変換（HMAC-SHA256）するための秘密の鍵。
# CRON_SECRET と同じく、推測されない長いランダム文字列にする（例：openssl rand -hex 32）。
IP_HASH_SECRET=

# OpenAI の APIキー。コメントの分類（AI）と、NG判定（Moderation API）に使う。取得方法は README の「OpenAI APIキーの取得」を参照。
# サーバーからだけ使う（NEXT_PUBLIC_ を付けない）。
OPENAI_API_KEY=

# 分類に使うモデル名（任意）。空なら src/lib/config/analysis.ts の DEFAULT_CLASSIFY_MODEL を使う。
OPENAI_CLASSIFY_MODEL=

# AIアドバイスに使うモデル名（任意）。空なら src/lib/config/analysis.ts の DEFAULT_ADVICE_MODEL を使う。
OPENAI_ADVICE_MODEL=
