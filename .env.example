# このファイルを .env.local にコピーして値を入れる（.env.local はコミットしない）。
# ローカル開発では `npx supabase start` の後に `npx supabase status` で表示される値を使う。

# [Supabase固有] プロジェクトのURLと anon キー。
# NEXT_PUBLIC_ で始まる変数はブラウザに公開される（Next.js の仕様）。
# anon キーは公開前提のキーで、データの保護は RLS が担う。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [Supabase固有] service role キー。RLS を無視して全データにアクセスできる。
# 絶対にブラウザへ出さない（NEXT_PUBLIC_ を付けない）。サーバーの src/server/ からのみ使う。
SUPABASE_SERVICE_ROLE_KEY=

# 期限切れ削除ジョブ（/api/cron/purge-expired）を呼び出すための共有シークレット。
# 推測されない長いランダム文字列にする（例：openssl rand -hex 32）。
CRON_SECRET=
